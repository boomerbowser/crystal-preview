.DS_Store

# The library, copied into the website so the site can be served as one tree.
# Generated by tools/assemble-site.mjs on every build, including Vercel's.
# Committing it would mean two copies of the library in one repository, and
# the separation between them exists precisely so that cannot happen.
website/vendor/

# Agent guidance kept locally, not distributed
AGENTS.md
CLAUDE.md
CODEX.md
.claude/

# Secrets. Never committed: a token in history is a token to rotate,
# and `git add -A` does not ask before staging a file nobody ignored.
.env
.env.*
!.env.example
